      "content": {
        "paragraphs": [
          {
            "text": "Our harbour office used to open every Monday with a flood of messages marked urgent. Nobody could remember why, yet everyone felt behind before nine.",
            "marks": [
              "strong"
            ]
          },
          {
            "text": "So we moved the first meeting to eleven and asked each person to write down one thing worth finishing that day."
          },
          {
            "text": "Within a month the urgent flags halved. People arrived curious instead of braced, and the work itself did not slow down at all.",
            "marks": [
              "underline"
            ]
          }
        ]
      },
