  "description": "Conversion closer of the about page: one giant headline figure plus a row of three stat-blocks (value + label) about the book, then the dark Download button (BuyNowButton) linking to the formats page. The stats sit in the SAME <section> as the button (markup.txt), so they are modelled as a stat-block component inside this CTA, not as a separate PROOF section.",
  "retrievalEligible": true,
  "flow": "in-flow",
  "variants": [],
  "content": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "stats",
      "ctaLabel",
      "ctaTo"
    ],
    "properties": {
      "stats": {
        "type": "array",
        "minItems": 4,
        "maxItems": 4,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "label"
          ],
          "properties": {
            "value": {
              "type": "string",
              "pattern": "^[0-9][0-9,.]*$",
              "maxLength": 12
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "maxWords": 7
            }
          }
        }
      },
      "ctaLabel": {
        "type": "string",
        "minLength": 1,
        "maxWords": 1
      },
      "ctaTo": {
        "type": "string",
        "pattern": "^/[a-z0-9/_-]*$",
        "maxLength": 120
      }
    }
  },
  "constraints": {
